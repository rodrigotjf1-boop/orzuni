# ── App iFood (modo CENTRALIZADO) ──────────────────────────────────────────
# Credenciais do APP do Orzuni no Portal do Desenvolvedor iFood.
# NUNCA commitar o .env real. No app de teste, pegar em Meus Apps → Credenciais.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_BASE=https://merchant-api.ifood.com.br

# Loja usada pelos scripts de teste/vigia (merchant da loja de teste)
IFOOD_MERCHANT_ID=

# ── Banco ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orzuni

# ── API do Orzuni ──────────────────────────────────────────────────────────
PORT=3100
