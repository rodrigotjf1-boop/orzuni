{
  "name": "orzuni-backend",
  "version": "0.1.0",
  "description": "Orzuni — controle de cardapio iFood (editor + vigia + API para ERP/CRM)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "vigia:scan": "node --env-file=.env scripts/vigia-scan.mjs",
    "db:init": "node --env-file=.env scripts/apply-sql.mjs database/001_init.sql"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
