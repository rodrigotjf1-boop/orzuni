{
  "name": "orzuni-backend",
  "version": "0.1.0",
  "description": "Orzuni — controle de cardapio iFood (editor + vigia + API para ERP/CRM)",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "vigia:scan": "node --env-file=.env scripts/vigia-scan.mjs",
    "db:init": "node --env-file=.env scripts/apply-sql.mjs database/001_init.sql"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^6.5.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
