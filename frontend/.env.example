# Base da API do Orzuni (o backend orzuni-api)
ORZUNI_API_BASE=https://api.orzuni.com
# Chave de API (server-side, NUNCA exposta ao navegador). Uma das do ORZUNI_API_KEYS do backend.
ORZUNI_API_KEY=

# ── Login do painel (obrigatório) ──────────────────────────────────────────
# Senha que o usuário digita para entrar no painel.
ORZUNI_APP_PASSWORD=
# Token secreto do cookie de sessão. Gere com: openssl rand -hex 32
ORZUNI_SESSION_TOKEN=
